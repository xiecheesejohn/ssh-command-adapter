# Use only after configuring a "gateway" target that opens your gateway shell.
# Add *.example.com to the host-name field of the private known_hosts entry
# for the adapter (keep the existing public key). On Linux use your generated
# UserKnownHostsFile path. This is interactive tssh login, not a TCP SSH proxy.
Host *.example.com
    User gateway
    ProxyCommand ssh-command-adapter --stdio --no-client-auth --target %r
    HostKeyAlias ssh-command-adapter
    UserKnownHostsFile "~/Library/Application Support/ssh-command-adapter/known_hosts"
    StrictHostKeyChecking yes
    ControlMaster no
    ControlPath none
    RequestTTY force
    RemoteCommand none
    #!! EnableTrzsz no
    #!! EnableZmodem no
    #!! EnableDragFile no
    #!! EnableOSC52 no
    #!! ExpectCount 1
    #!! ExpectTimeout 300
    #!! ExpectPattern1 *gateway$*
    #!! ExpectSendText1 ssh %r@%h\r
